{
  "uid": "netfly-runtime",
  "title": "Netfly Runtime",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "netfly",
    "hyperf",
    "observability",
    "netfly-split"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total, project)",
        "refresh": 2,
        "current": {
          "text": "demo-shop",
          "value": "demo-shop"
        }
      },
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total{project=\"$project\"}, env)",
        "refresh": 2,
        "current": {
          "text": "local",
          "value": "local"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total{project=\"$project\",env=\"$env\"}, service)",
        "refresh": 2,
        "current": {
          "text": "demo-api",
          "value": "demo-api"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total{project=\"$project\",env=\"$env\",service=\"$service\"}, route)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "log_type",
        "label": "Log Type",
        "type": "custom",
        "query": "request,error,slow,db,redis,amqp,app",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "slow_ms",
        "label": "Slow >= ms",
        "type": "textbox",
        "query": "100",
        "current": {
          "text": "100",
          "value": "100"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "title": "PHP Memory Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "netfly_php_memory_usage_bytes{project=\"$project\",env=\"$env\",service=\"$service\"}",
          "legendFormat": "usage"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "netfly_php_memory_peak_bytes{project=\"$project\",env=\"$env\",service=\"$service\"}",
          "legendFormat": "peak"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Swoole Coroutine Count",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "netfly_swoole_coroutine_num{project=\"$project\",env=\"$env\",service=\"$service\"}",
          "legendFormat": "coroutines"
        }
      ]
    },
    {
      "id": 14,
      "title": "All Log Volume By Type",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (log_type, level) (rate({project=\"$project\",env=\"$env\",service=\"$service\",log_type=~\"$log_type\"}[$__rate_interval]))",
          "legendFormat": "{{log_type}} {{level}}"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Netfly dashboards",
      "type": "dashboards",
      "tags": [
        "netfly-split"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
