{
  "uid": "netfly-rabbitmq",
  "title": "Netfly RabbitMQ",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": ["netfly", "request-journey"],
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": [
    {"name": "project", "label": "Project", "type": "query", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "query": "label_values(netfly_amqp_duration_seconds_count, project)", "refresh": 2, "current": {"text": "demo-shop", "value": "demo-shop"}},
    {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "query": "label_values(netfly_amqp_duration_seconds_count{project=\"$project\"}, env)", "refresh": 2, "current": {"text": "local", "value": "local"}},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "query": "label_values(netfly_amqp_duration_seconds_count{project=\"$project\",env=\"$env\"}, service)", "refresh": 2, "current": {"text": "demo-api", "value": "demo-api"}},
    {"name": "scenario", "label": "Scenario", "type": "custom", "query": "order_create,payment_callback,message_consume,mixed_traffic", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "trace_id", "label": "Trace ID", "type": "textbox", "query": "", "current": {"text": ".*", "value": ".*"}}
  ]},
  "panels": [
    {"id": 1, "title": "Publish Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "sum by (operation, queue) (rate(netfly_amqp_publish_total{project=\"$project\",env=\"$env\",service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{queue}}"}]},
    {"id": 2, "title": "Consume Rate", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "sum by (operation, queue) (rate(netfly_amqp_consume_total{project=\"$project\",env=\"$env\",service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{queue}}"}]},
    {"id": 3, "title": "AMQP P95 Latency", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(netfly_amqp_duration_seconds_bucket{project=\"$project\",env=\"$env\",service=\"$service\"}[$__rate_interval])) by (le, operation, queue))", "legendFormat": "{{operation}} {{queue}} p95"}]},
    {"id": 4, "title": "Recent RabbitMQ Calls", "type": "logs", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8}, "targets": [{"datasource": {"type": "loki", "uid": "Loki"}, "expr": "{project=\"$project\",env=\"$env\",service=\"$service\",log_type=\"amqp\"} | json | scenario=~\"$scenario\" | trace_id=~\"$trace_id\" | line_format \"{{.timestamp}} {{.scenario}} {{.span_kind}} {{.operation}} {{.exchange}}/{{.queue}} {{.routing_key}} {{.duration_ms}}ms trace={{.trace_id}}\""}]}
  ],
  "links": [{"title": "Netfly dashboards", "type": "dashboards", "tags": ["request-journey"], "asDropdown": true, "includeVars": true, "keepTime": true}]
}
