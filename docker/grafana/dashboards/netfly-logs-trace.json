{
  "uid": "netfly-logs-trace",
  "title": "Netfly Logs / Trace",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": [
    "netfly",
    "hyperf",
    "observability",
    "netfly-split"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total, project)",
        "refresh": 2,
        "current": {
          "text": "demo-shop",
          "value": "demo-shop"
        }
      },
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total{project=\"$project\"}, env)",
        "refresh": 2,
        "current": {
          "text": "local",
          "value": "local"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total{project=\"$project\",env=\"$env\"}, service)",
        "refresh": 2,
        "current": {
          "text": "demo-api",
          "value": "demo-api"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "query": "label_values(netfly_http_requests_total{project=\"$project\",env=\"$env\",service=\"$service\"}, route)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "log_type",
        "label": "Log Type",
        "type": "custom",
        "query": "request,error,slow,db,redis,amqp,app",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "slow_ms",
        "label": "Slow >= ms",
        "type": "textbox",
        "query": "100",
        "current": {
          "text": "100",
          "value": "100"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 24,
      "title": "Application Errors",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{project=\"$project\",env=\"$env\",service=\"$service\",log_type=\"error\"} | json"
        }
      ]
    },
    {
      "id": 25,
      "title": "Trace Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{project=\"$project\",env=\"$env\",service=\"$service\"} | json | trace_id=\"$trace_id\""
        }
      ]
    },
    {
      "id": 26,
      "title": "All Queryable Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{project=\"$project\",env=\"$env\",service=\"$service\",log_type=~\"$log_type\"} | json"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Netfly dashboards",
      "type": "dashboards",
      "tags": [
        "netfly-split"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ]
}
