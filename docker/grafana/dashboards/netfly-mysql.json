{
  "uid": "netfly-mysql",
  "title": "Netfly MySQL",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "tags": ["netfly", "request-journey"],
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": [
    {"name": "project", "label": "Project", "type": "query", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "query": "label_values(netfly_db_queries_total, project)", "refresh": 2, "current": {"text": "demo-shop", "value": "demo-shop"}},
    {"name": "env", "label": "Env", "type": "query", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "query": "label_values(netfly_db_queries_total{project=\"$project\"}, env)", "refresh": 2, "current": {"text": "local", "value": "local"}},
    {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "Prometheus"}, "query": "label_values(netfly_db_queries_total{project=\"$project\",env=\"$env\"}, service)", "refresh": 2, "current": {"text": "demo-api", "value": "demo-api"}},
    {"name": "scenario", "label": "Scenario", "type": "custom", "query": "order_create,order_query,payment_callback,inventory_reserve,slow_demo,error_demo,mixed_traffic", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}},
    {"name": "trace_id", "label": "Trace ID", "type": "textbox", "query": "", "current": {"text": ".*", "value": ".*"}}
  ]},
  "panels": [
    {"id": 1, "title": "Query Rate By Operation", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "sum by (operation) (rate(netfly_db_queries_total{project=\"$project\",env=\"$env\",service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{operation}}"}]},
    {"id": 2, "title": "Query P95 Latency", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "targets": [{"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(netfly_db_query_duration_seconds_bucket{project=\"$project\",env=\"$env\",service=\"$service\"}[$__rate_interval])) by (le, operation))", "legendFormat": "{{operation}} p95"}]},
    {"id": 3, "title": "MySQL Errors And Slow Queries", "type": "logs", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "targets": [{"datasource": {"type": "loki", "uid": "Loki"}, "expr": "{project=\"$project\",env=\"$env\",service=\"$service\",log_type=~\"db|slow\",component=\"mysql\"} | json | scenario=~\"$scenario\" | trace_id=~\"$trace_id\" | line_format \"{{.scenario}} {{.operation}} {{.table}} {{.duration_ms}}ms {{.result}} trace={{.trace_id}}\""}]},
    {"id": 4, "title": "Recent MySQL Calls", "type": "logs", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8}, "targets": [{"datasource": {"type": "loki", "uid": "Loki"}, "expr": "{project=\"$project\",env=\"$env\",service=\"$service\",log_type=\"db\"} | json | scenario=~\"$scenario\" | trace_id=~\"$trace_id\" | line_format \"{{.timestamp}} {{.scenario}} {{.span_id}} <- {{.parent_span_id}} mysql {{.operation}} table={{.table}} {{.duration_ms}}ms\""}]}
  ],
  "links": [{"title": "Netfly dashboards", "type": "dashboards", "tags": ["request-journey"], "asDropdown": true, "includeVars": true, "keepTime": true}]
}
